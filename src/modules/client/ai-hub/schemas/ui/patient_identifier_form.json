{
  "id": "patient-identifier-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "patient-identifier-form",
      "type": "Form",
      "properties": {
        "action": { "name": "add_patient_identifier" },
        "submitLabel": { "literalString": "Add Identifier" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Add Patient Identifier" },
              "usageHint": "h2"
            }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Attach a business identifier such as MRN, SSN, insurance ID, or passport number." },
              "usageHint": "caption"
            }
          },
          {
            "id": "divider-top",
            "type": "Divider",
            "properties": {}
          },
          {
            "id": "system",
            "type": "TextField",
            "properties": {
              "label": { "literalString": "Identifier System (URI)" },
              "placeholder": { "literalString": "e.g. http://hospital.example.com/mrn" },
              "textFieldType": "shortText"
            }
          },
          {
            "id": "value",
            "type": "TextField",
            "properties": {
              "label": { "literalString": "Identifier Value" },
              "placeholder": { "literalString": "e.g. MRN-123456" },
              "textFieldType": "shortText"
            }
          }
        ]
      }
    }
  }
}
