{
  "id": "patient-telecom-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "patient-telecom-form",
      "type": "Form",
      "properties": {
        "action": { "name": "add_patient_telecom" },
        "submitLabel": { "literalString": "Add Contact" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Add Contact Point" },
              "usageHint": "h2"
            }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Append a phone number, email address, or other contact point to the patient record." },
              "usageHint": "caption"
            }
          },
          {
            "id": "divider-top",
            "type": "Divider",
            "properties": {}
          },
          {
            "id": "system",
            "type": "MultipleChoice",
            "properties": {
              "label": { "literalString": "Contact Type" },
              "placeholder": { "literalString": "Select contact type" },
              "items": [
                { "label": { "literalString": "Phone" }, "value": "phone" },
                { "label": { "literalString": "Email" }, "value": "email" },
                { "label": { "literalString": "SMS" }, "value": "sms" },
                { "label": { "literalString": "Fax" }, "value": "fax" },
                { "label": { "literalString": "URL" }, "value": "url" },
                { "label": { "literalString": "Pager" }, "value": "pager" },
                { "label": { "literalString": "Other" }, "value": "other" }
              ]
            }
          },
          {
            "id": "value",
            "type": "TextField",
            "properties": {
              "label": { "literalString": "Contact Value" },
              "placeholder": { "literalString": "e.g. +1-555-123-4567 or user@example.com" },
              "textFieldType": "shortText"
            }
          },
          {
            "id": "use",
            "type": "MultipleChoice",
            "properties": {
              "label": { "literalString": "Use" },
              "placeholder": { "literalString": "Select purpose (optional)" },
              "items": [
                { "label": { "literalString": "Home" }, "value": "home" },
                { "label": { "literalString": "Work" }, "value": "work" },
                { "label": { "literalString": "Mobile" }, "value": "mobile" },
                { "label": { "literalString": "Temp" }, "value": "temp" },
                { "label": { "literalString": "Old" }, "value": "old" }
              ]
            }
          }
        ]
      }
    }
  }
}
