{
  "id": "patient-contact-root",
  "type": "Card",
  "properties": {
    "child": {
      "id": "patient-contact-form",
      "type": "Form",
      "properties": {
        "action": { "name": "add_patient_contact" },
        "submitLabel": { "literalString": "Add Contact" },
        "gap": "medium",
        "alignment": "stretch",
        "children": [
          {
            "id": "form-title",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Add Emergency Contact" },
              "usageHint": "h2"
            }
          },
          {
            "id": "form-subtitle",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Add a next-of-kin, guardian, or emergency contact for this patient." },
              "usageHint": "caption"
            }
          },
          {
            "id": "divider-top",
            "type": "Divider",
            "properties": {}
          },
          {
            "id": "section-name",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Contact Name" },
              "usageHint": "h4"
            }
          },
          {
            "id": "contact-name-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "name_given",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Given Name" },
                    "placeholder": { "literalString": "First name" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "name_family",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Family Name" },
                    "placeholder": { "literalString": "Last name" },
                    "textFieldType": "shortText"
                  }
                }
              ]
            }
          },
          {
            "id": "gender",
            "type": "MultipleChoice",
            "properties": {
              "label": { "literalString": "Gender (optional)" },
              "placeholder": { "literalString": "Select gender" },
              "items": [
                { "label": { "literalString": "Male" }, "value": "male" },
                { "label": { "literalString": "Female" }, "value": "female" },
                { "label": { "literalString": "Other" }, "value": "other" },
                { "label": { "literalString": "Unknown" }, "value": "unknown" }
              ]
            }
          },
          {
            "id": "divider-mid",
            "type": "Divider",
            "properties": {}
          },
          {
            "id": "section-address",
            "type": "Text",
            "properties": {
              "text": { "literalString": "Contact Address (optional)" },
              "usageHint": "h4"
            }
          },
          {
            "id": "address_line",
            "type": "TextField",
            "properties": {
              "label": { "literalString": "Street Address" },
              "placeholder": { "literalString": "e.g. 456 Oak Avenue" },
              "textFieldType": "shortText"
            }
          },
          {
            "id": "contact-city-state-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "address_city",
                  "type": "TextField",
                  "weight": 2,
                  "properties": {
                    "label": { "literalString": "City" },
                    "placeholder": { "literalString": "City" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "address_state",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "State" },
                    "placeholder": { "literalString": "State" },
                    "textFieldType": "shortText"
                  }
                }
              ]
            }
          },
          {
            "id": "contact-postal-country-row",
            "type": "Row",
            "properties": {
              "gap": "medium",
              "alignment": "stretch",
              "children": [
                {
                  "id": "address_postal_code",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Postal Code" },
                    "placeholder": { "literalString": "ZIP / Postal code" },
                    "textFieldType": "shortText"
                  }
                },
                {
                  "id": "address_country",
                  "type": "TextField",
                  "weight": 1,
                  "properties": {
                    "label": { "literalString": "Country" },
                    "placeholder": { "literalString": "Country" },
                    "textFieldType": "shortText"
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
