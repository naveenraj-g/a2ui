{
  "id": "create_patient",
  "name": "Create Patient",
  "description": "Create a new Patient resource and optionally append identifiers, telecom contact points, and addresses as part of patient onboarding.",
  "version": "1.0.0",
  "tags": ["fhir", "patient", "create", "crud", "healthcare", "onboarding"],
  "llm_hints": {
    "intent_examples": [
      "Create a new patient",
      "Register patient",
      "Create patient profile",
      "Add patient demographics",
      "Register patient with phone number",
      "Create patient with address"
    ],
    "when_to_use": [
      "User wants to create a new Patient resource",
      "User is onboarding a patient",
      "User provides demographic information for a new patient",
      "User wants to register a patient in the healthcare system"
    ],
    "when_not_to_use": [
      "User wants to update an existing patient's details",
      "User wants to search or list patients",
      "User wants to delete a patient",
      "User wants to view patient information",
      "User provides a patient ID referring to an existing patient"
    ],
    "required_context": []
  },
  "execution": {
    "mode": "deterministic",
    "orchestrator": "nextjs",
    "audit_enabled": true
  },
  "introduction": "I'll help you register a new patient. This is a 4-step process — the first step creates the core patient record, and the remaining 3 (identifier, contact point, and address) are optional and can be skipped.",
  "completion": {
    "message": "Patient registration complete. The patient record has been created and configured with the provided details.",
    "action": "dismiss"
  },
  "workflow_steps": [
    {
      "sequence_number": 1,
      "id": "create_patient_resource",
      "name": "Create Patient Resource",
      "step_type": "form",
      "description": "Create the base Patient resource using demographic details including name, birth date, gender, and active status.",
      "context": {
        "inputs": {},
        "outputs": {
          "patient_id": {
            "type": "integer",
            "resource": "Patient",
            "field": "id"
          }
        }
      },
      "context_resolvers": [
        {
          "description": "Fetch administrative-gender value set for the Gender select.",
          "context_key": "gender_concepts",
          "tool_name": "get_gender_valueset",
          "url": "$fhir_server_url/api/fhir/v1/terminology/concepts?resource=Patient&field=gender",
          "method": "GET",
          "timeout_ms": 8000
        },
        {
          "description": "Fetch marital-status value set for the Marital Status select.",
          "context_key": "marital_status_concepts",
          "tool_name": "get_marital_status_valueset",
          "url": "$fhir_server_url/api/fhir/v1/terminology/concepts?resource=Patient&field=maritalStatus",
          "method": "GET",
          "timeout_ms": 8000
        }
      ],
      "ui": {
        "schema": "patient_create_form",
        "mode": "create",
        "prefill": false,
        "editable": true
      },
      "actions": [
        {
          "type": "http",
          "purpose": "create_patient",
          "tool_name": "create_patient",
          "url": "$fhir_server_url/api/fhir/v1/patients/",
          "method": "POST",
          "validation_schema": "patient_create_schema",
          "retryable": true,
          "timeout_ms": 10000
        }
      ]
    },
    {
      "sequence_number": 2,
      "id": "add_patient_identifier",
      "name": "Add Patient Identifier",
      "step_type": "form",
      "optional": true,
      "description": "Append business identifiers such as MRN, insurance ID, passport number, or national identifier to the Patient resource.",
      "context": {
        "inputs": {
          "patient_id": {
            "type": "integer",
            "resource": "Patient",
            "source": "workflow"
          }
        },
        "outputs": {
          "patient_identifier_resource": {
            "type": "Identifier"
          }
        }
      },
      "context_resolver": {
        "description": "Confirm the Patient still exists in the database before appending identifiers — guards against partial completion if the user previously exited mid-workflow.",
        "tool_name": "get_patient_by_id",
        "url": "$fhir_server_url/api/fhir/v1/patients/$patient_id",
        "method": "GET",
        "timeout_ms": 10000
      },
      "ui": {
        "schema": "patient_identifier_form",
        "mode": "append",
        "prefill": false,
        "editable": true
      },
      "actions": [
        {
          "type": "http",
          "purpose": "add_patient_identifier",
          "tool_name": "add_patient_identifier",
          "url": "$fhir_server_url/api/fhir/v1/patients/$patient_id/identifiers",
          "method": "POST",
          "validation_schema": "identifier_create_schema",
          "retryable": true,
          "timeout_ms": 10000
        }
      ]
    },
    {
      "sequence_number": 3,
      "id": "add_patient_telecom",
      "name": "Add Patient Telecom",
      "step_type": "form",
      "optional": true,
      "description": "Append telecom communication details such as mobile number, phone number, email address, or fax.",
      "context": {
        "inputs": {
          "patient_id": {
            "type": "integer",
            "resource": "Patient",
            "source": "workflow"
          }
        },
        "outputs": {
          "patient_telecom_resource": {
            "type": "ContactPoint"
          }
        }
      },
      "context_resolver": {
        "description": "Confirm the Patient still exists in the database before appending telecom — guards against partial completion if the user previously exited mid-workflow.",
        "tool_name": "get_patient_by_id",
        "url": "$fhir_server_url/api/fhir/v1/patients/$patient_id",
        "method": "GET",
        "timeout_ms": 10000
      },
      "ui": {
        "schema": "patient_telecom_form",
        "mode": "append",
        "prefill": false,
        "editable": true
      },
      "actions": [
        {
          "type": "http",
          "purpose": "add_patient_telecom",
          "tool_name": "add_patient_telecom",
          "url": "$fhir_server_url/api/fhir/v1/patients/$patient_id/telecom",
          "method": "POST",
          "validation_schema": "telecom_create_schema",
          "retryable": true,
          "timeout_ms": 10000
        }
      ]
    },
    {
      "sequence_number": 4,
      "id": "add_patient_address",
      "name": "Add Patient Address",
      "step_type": "form",
      "optional": true,
      "description": "Append postal or physical address information to the Patient resource.",
      "context": {
        "inputs": {
          "patient_id": {
            "type": "integer",
            "resource": "Patient",
            "source": "workflow"
          }
        },
        "outputs": {
          "patient_address_resource": {
            "type": "Address"
          }
        }
      },
      "context_resolver": {
        "description": "Confirm the Patient still exists in the database before appending an address — guards against partial completion if the user previously exited mid-workflow.",
        "tool_name": "get_patient_by_id",
        "url": "$fhir_server_url/api/fhir/v1/patients/$patient_id",
        "method": "GET",
        "timeout_ms": 10000
      },
      "ui": {
        "schema": "patient_address_form",
        "mode": "append",
        "prefill": false,
        "editable": true
      },
      "actions": [
        {
          "type": "http",
          "purpose": "add_patient_address",
          "tool_name": "add_patient_address",
          "url": "$fhir_server_url/api/fhir/v1/patients/$patient_id/addresses",
          "method": "POST",
          "validation_schema": "address_create_schema",
          "retryable": true,
          "timeout_ms": 10000
        }
      ]
    }
  ]
}
