{
  "id": "create_patient",
  "name": "Create Patient",
  "description": "Create a new Patient resource and optionally append identifiers, telecom contact points, and addresses as part of patient onboarding.",
  "version": "1.0.0",
  "tags": ["fhir", "patient", "create", "crud", "healthcare", "onboarding"],
  "llm_hints": {
    "intent_examples": [
      "Create a new patient",
      "Register patient",
      "Create patient profile",
      "Add patient demographics",
      "Register patient with phone number",
      "Create patient with address"
    ],
    "when_to_use": [
      "User wants to create a new Patient resource",
      "User is onboarding a patient",
      "User provides demographic information for a new patient",
      "User wants to register a patient in the healthcare system"
    ],
    "required_context": []
  },
  "execution": {
    "mode": "deterministic",
    "orchestrator": "nextjs",
    "retryable": true,
    "audit_enabled": true
  },
  "workflow_steps": [
    {
      "sequence_number": 1,
      "id": "create_patient_resource",
      "name": "Create Patient Resource",
      "step_type": "form",
      "description": "Create the base Patient resource using demographic details including name, birth date, gender, preferred language, and active status.",
      "context": {
        "inputs": {},
        "outputs": {
          "patient_id": {
            "type": "integer",
            "resource": "Patient",
            "field": "id"
          },
          "patient_resource": {
            "type": "Patient"
          }
        }
      },
      "ui": {
        "schema": "patient_create_form",
        "mode": "create",
        "prefill": false,
        "editable": true,
        "submit_label": "Create Patient"
      },
      "actions": [
        {
          "type": "http",
          "purpose": "create_patient",
          "tool_name": "create_patient",
          "url": "http://localhost:8001/api/fhir/v1/patients/",
          "method": "POST",
          "validation_schema": "patient_create_schema",
          "retryable": true
        }
      ]
    },
    {
      "sequence_number": 2,
      "id": "add_patient_identifier",
      "name": "Add Patient Identifier",
      "step_type": "form",
      "optional": true,
      "description": "Append business identifiers such as MRN, insurance ID, passport number, or national identifier to the Patient resource.",
      "context": {
        "inputs": {
          "patient_id": {
            "type": "integer",
            "resource": "Patient",
            "source": "workflow"
          }
        },
        "outputs": {
          "patient_identifier_resource": {
            "type": "Identifier"
          }
        }
      },
      "context_resolver": {
        "description": "Validate that the Patient exists and hydrate the latest Patient resource before appending identifiers.",
        "tool_name": "get_patient_by_id",
        "url": "http://localhost:8001/api/fhir/v1/patients/$patient_id",
        "method": "GET"
      },
      "ui": {
        "schema": "patient_identifier_form",
        "mode": "create",
        "prefill": false,
        "editable": true,
        "submit_label": "Add Identifier"
      },
      "actions": [
        {
          "type": "http",
          "purpose": "add_patient_identifier",
          "tool_name": "add_patient_identifier",
          "url": "http://localhost:8001/api/fhir/v1/patients/$patient_id/identifiers",
          "method": "POST",
          "validation_schema": "identifier_create_schema",
          "retryable": true
        }
      ]
    },
    {
      "sequence_number": 3,
      "id": "add_patient_telecom",
      "name": "Add Patient Telecom",
      "step_type": "form",
      "optional": true,
      "description": "Append telecom communication details such as mobile number, phone number, email address, or fax.",
      "context": {
        "inputs": {
          "patient_id": {
            "type": "integer",
            "resource": "Patient",
            "source": "workflow"
          }
        },
        "outputs": {
          "patient_telecom_resource": {
            "type": "ContactPoint"
          }
        }
      },
      "context_resolver": {
        "description": "Validate that the Patient exists and hydrate the latest Patient resource before appending telecom information.",
        "tool_name": "get_patient_by_id",
        "url": "http://localhost:8001/api/fhir/v1/patients/$patient_id",
        "method": "GET"
      },
      "ui": {
        "schema": "patient_telecom_form",
        "mode": "create",
        "prefill": false,
        "editable": true,
        "submit_label": "Add Telecom"
      },
      "actions": [
        {
          "type": "http",
          "purpose": "add_patient_telecom",
          "tool_name": "add_patient_telecom",
          "url": "http://localhost:8001/api/fhir/v1/patients/$patient_id/telecom",
          "method": "POST",
          "validation_schema": "telecom_create_schema",
          "retryable": true
        }
      ]
    },
    {
      "sequence_number": 4,
      "id": "add_patient_address",
      "name": "Add Patient Address",
      "step_type": "form",
      "optional": true,
      "description": "Append postal or physical address information to the Patient resource.",
      "context": {
        "inputs": {
          "patient_id": {
            "type": "integer",
            "resource": "Patient",
            "source": "workflow"
          }
        },
        "outputs": {
          "patient_address_resource": {
            "type": "Address"
          }
        }
      },
      "context_resolver": {
        "description": "Validate that the Patient exists and hydrate the latest Patient resource before appending address information.",
        "tool_name": "get_patient_by_id",
        "url": "http://localhost:8001/api/fhir/v1/patients/$patient_id",
        "method": "GET"
      },
      "ui": {
        "schema": "patient_address_form",
        "mode": "create",
        "prefill": false,
        "editable": true,
        "submit_label": "Add Address"
      },
      "actions": [
        {
          "type": "http",
          "purpose": "add_patient_address",
          "tool_name": "add_patient_address",
          "url": "http://localhost:8001/api/fhir/v1/patients/$patient_id/addresses",
          "method": "POST",
          "validation_schema": "address_create_schema",
          "retryable": true
        }
      ]
    }
  ]
}
