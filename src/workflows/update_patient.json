{
  "id": "update_patient",
  "name": "Update Patient",
  "description": "Fetch a patient by ID, display pre-filled form, and submit updates",
  "entryStep": "get_patient",
  "steps": {
    "get_patient": {
      "schema": "update_patient_form",
      "method": "GET",
      "tool": "get_patient",
      "contextArgs": {
        "id": "$context.patient_id"
      },
      "nextStep": "submit_update"
    },
    "submit_update": {
      "schema": "update_patient_form",
      "method": "POST",
      "tool": "update_patient",
      "prefillFromContext": true
    }
  }
}
